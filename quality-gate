#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
BASELINE="$ROOT/quality-baseline.env"
[[ -f "$BASELINE" ]] || { echo "[FAIL] missing quality-baseline.env" >&2; exit 1; }
# shellcheck disable=SC1090
source "$BASELINE"

if [[ -n "${QUALITY_BASELINE_UPDATE:-}" ]]; then
  echo "[FAIL] automatic baseline updates are forbidden; edit quality-baseline.env explicitly for review" >&2
  exit 1
fi
TIME_PLATFORM="$(uname -s)"
case "$TIME_PLATFORM" in
  Darwin) TIME_ARGS=(-l) ;;
  Linux) TIME_ARGS=(-v) ;;
  *) echo "[FAIL] unsupported time measurement platform" >&2; exit 1 ;;
esac
if ! docker info >/dev/null 2>&1; then
  echo "[FAIL] Docker daemon is required for the database-backed quality corpus" >&2
  exit 1
fi

"$ROOT/accuracy-gate"

CORPUS="$ROOT/backend/src/test/resources/fixtures"
CORPUS_FILES="$(find "$CORPUS" -type f | wc -l | tr -d ' ')"
if (( CORPUS_FILES < MIN_CORPUS_FILES )); then
  echo "[FAIL] corpus has $CORPUS_FILES files; baseline requires $MIN_CORPUS_FILES" >&2
  exit 1
fi

TIME_LOG="$(mktemp)"
cleanup() { rm -f "$TIME_LOG"; }
trap cleanup EXIT
START="$(date +%s)"

GRADLE_ARGS=(
  --offline
  test
  --tests '*.FixtureGoldenTest'
  --tests '*.SpringMiniGraphGoldenTest'
  --tests '*.SpringMiniEndpointsFeaturesGoldenTest'
  --tests '*.ReactMiniTsParsingGoldenTest'
  --tests '*.FullstackCrossDomainGoldenTest'
  --tests '*.ConfigAnalyzersGoldenTest'
)

# Capture stderr directly: process-substitution tee can still be writing when read.
# Pin time's labels to English; this remains one Gradle invocation, not process-tree G-PERF.
RUN_STATUS=0
LC_ALL=C /usr/bin/time "${TIME_ARGS[@]}" "$ROOT/backend/gradlew" -p "$ROOT/backend" "${GRADLE_ARGS[@]}" 2> "$TIME_LOG" || RUN_STATUS=$?
ELAPSED=$(( $(date +%s) - START ))
LOG_STATUS=0
cat "$TIME_LOG" >&2 || LOG_STATUS=$?
METRICS_STATUS=0
RSS_KB="$(node "$ROOT/validation/pre-release/quality-metrics.cjs" \
  "$TIME_PLATFORM" "$TIME_LOG" "$RUN_STATUS" "$ELAPSED" \
  "$MAX_BACKEND_SECONDS" "$MAX_BACKEND_RSS_KB")" || METRICS_STATUS=$?
# Keep the original command failure even if parsing, Node or log replay also failed.
if (( RUN_STATUS != 0 )); then exit "$RUN_STATUS"; fi
if (( LOG_STATUS != 0 )); then exit "$LOG_STATUS"; fi
if (( METRICS_STATUS != 0 )); then exit "$METRICS_STATUS"; fi

for analyzer in ts-analyzer tree-analyzer; do
  (
    cd "$ROOT/analyzers/$analyzer"
    npm test -- --run
    npm run typecheck
    npm run build
  )
done

printf '[PASS] quality baseline v%s: corpus=%s files, backend=%ss, timed-gradle-rss=%sKiB\n' \
  "$QUALITY_BASELINE_VERSION" "$CORPUS_FILES" "$ELAPSED" "$RSS_KB"
