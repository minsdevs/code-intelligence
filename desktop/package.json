{
  "name": "code-intelligence-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Code Intelligence desktop runtime",
  "main": "src/main.cjs",
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "stage": "node scripts/stage-runtime.mjs",
    "start": "electron .",
    "pack:mac": "npm run stage && electron-builder --mac dir",
    "dist:mac": "npm run stage && electron-builder --mac dmg zip",
    "check:windows": "node scripts/windows-readiness.cjs",
    "pack:win": "npm run check:windows && electron-builder --win dir --x64 --publish never",
    "dist:win": "npm run check:windows && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.codeintelligence.desktop",
    "productName": "Code Intelligence",
    "asar": true,
    "beforePack": "./scripts/desktop-build-gate.cjs",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "stage/runtime",
        "to": "runtime"
      }
    ],
    "mac": {
      "minimumSystemVersion": "13.0",
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "sign": true
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "requestedExecutionLevel": "asInvoker",
      "forceCodeSigning": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "${productName}-${version}-${arch}-${os}.${ext}"
  }
}
