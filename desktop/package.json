{
  "name": "code-intelligence-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Code Intelligence desktop runtime",
  "main": "src/main.cjs",
  "scripts": {
    "stage": "node scripts/stage-runtime.mjs",
    "start": "electron .",
    "pack:mac": "npm run stage && electron-builder --mac dir",
    "dist:mac": "npm run stage && electron-builder --mac dmg zip"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.codeintelligence.desktop",
    "productName": "Code Intelligence",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "stage/runtime",
        "to": "runtime"
      }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "sign": true
    },
    "artifactName": "${productName}-${version}-${arch}-${os}.${ext}"
  }
}
