# Copy to .env and adjust. `.env` is gitignored — never commit real values.
# docker compose reads this file automatically; the backend reads these as
# environment variables (all have local-dev defaults, see backend/src/main/resources/application.yml).

# ── Local infrastructure (docker compose) ────────────────────────────────
POSTGRES_DB=codeintel
POSTGRES_USER=codeintel
POSTGRES_PASSWORD=codeintel-local

# ── Backend ──────────────────────────────────────────────────────────────
# Defaults match docker-compose; uncomment to override.
#DB_URL=jdbc:postgresql://localhost:5432/codeintel
#DB_USERNAME=codeintel
#DB_PASSWORD=codeintel-local
#REDIS_HOST=localhost
#REDIS_PORT=6379
#SERVER_PORT=8080

# ── Auth (Phase 1) ───────────────────────────────────────────────────────
# REQUIRED to start the backend: key for AES-256-GCM encryption of stored
# GitHub tokens (must decode to exactly 32 bytes; startup fails otherwise).
# Generate with: openssl rand -base64 32
TOKEN_ENC_KEY=

# OPTIONAL GitHub OAuth App credentials. When unset, OAuth login is simply
# disabled and PAT registration (POST /api/auth/pat) is the login path.
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=

# Comma-separated origins allowed for CORS (default: the Vite dev server).
#CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Repository storage (Phase 1) ─────────────────────────────────────────
# Where cloned repositories are stored, under ${DATA_DIR}/repos/{projectId}
# (default: ~/.code-intelligence)
#DATA_DIR=

# ── ts-analyzer sidecar (Phase 2) ────────────────────────────────────────
# Empty = skip TS_PARSING (Java-only repos still succeed). Set to
# http://127.0.0.1:3040 when the sidecar is running.
#TS_ANALYZER_BASE_URL=http://127.0.0.1:3040
# Empty = skip tree-sitter parsing. Set to http://127.0.0.1:3041 when the
# sidecar is running.
#TREE_ANALYZER_BASE_URL=http://127.0.0.1:3041

# ── AI (Phase 3) ─────────────────────────────────────────────────────────
# Environment keys are an optional server-wide fallback. The Settings UI can
# store a per-user key encrypted at rest; blank values disable the assistant.
#AI_PROVIDER=openai
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#OPENAI_CHAT_MODEL=gpt-4o-mini
#OPENAI_EMBED_MODEL=text-embedding-3-small
#GEMINI_CHAT_MODEL=gemini-2.5-flash
# Gemini Embedding 001 is requested at 1536 dimensions to match pgvector(1536).
#GEMINI_EMBED_MODEL=gemini-embedding-001
# Optional comma-separated allowlist for the chat-model selector. The configured
# chat model is always included. Embedding models remain environment-only because
# summaries use a fixed pgvector(1536) schema.
#OPENAI_CHAT_MODELS=gpt-4o-mini,gpt-4.1-mini
#GEMINI_CHAT_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
#AI_DAILY_TOKEN_LIMIT=500000
