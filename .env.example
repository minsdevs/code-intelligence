# Copy to .env and adjust. `.env` is gitignored — never commit real values.
# docker compose reads this file automatically; the backend reads these as
# environment variables (all have local-dev defaults, see backend/src/main/resources/application.yml).

# ── Local infrastructure (docker compose) ────────────────────────────────
POSTGRES_DB=codeintel
POSTGRES_USER=codeintel
POSTGRES_PASSWORD=codeintel-local

# ── Backend ──────────────────────────────────────────────────────────────
# Defaults match docker-compose; uncomment to override.
#DB_URL=jdbc:postgresql://localhost:5432/codeintel
#DB_USERNAME=codeintel
#DB_PASSWORD=codeintel-local
#REDIS_HOST=localhost
#REDIS_PORT=6379
#SERVER_PORT=8080

# ── Auth (Phase 1) ───────────────────────────────────────────────────────
# REQUIRED to start the backend: key for AES-256-GCM encryption of stored
# GitHub tokens (must decode to exactly 32 bytes; startup fails otherwise).
# Generate with: openssl rand -base64 32
TOKEN_ENC_KEY=

# OPTIONAL GitHub OAuth App credentials. When unset, OAuth login is simply
# disabled and PAT registration (POST /api/auth/pat) is the login path.
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=

# Comma-separated origins allowed for CORS (default: the Vite dev server).
#CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Phase 1+ (not used yet) ──────────────────────────────────────────────
# Where cloned repositories are stored (default: ~/.code-intelligence)
#DATA_DIR=
