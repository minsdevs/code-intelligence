#!/usr/bin/env bash
# check-local — run pre-flight checks without starting any services.
# Usage: ./check-local
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

info()  { echo -e "${BLUE}[INFO]${NC} $*"; }
ok()    { echo -e "${GREEN}[OK]${NC} $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
fail()  { echo -e "${RED}[FAIL]${NC} $*"; }

CHECKS_PASSED=true
WARN_COUNT=0

check_command() {
  local cmd="$1" install_hint="$2"
  if command -v "$cmd" &>/dev/null; then
    ok "$cmd found"
  else
    fail "$cmd not found. Install: $install_hint"
    CHECKS_PASSED=false
  fi
}

check_java_version() {
  if ! command -v java &>/dev/null; then
    fail "java not found. Install JDK 21+"
    CHECKS_PASSED=false
    return
  fi
  local ver
  ver=$(java -version 2>&1 | head -1 | grep -oE '[0-9]+' | head -1)
  if [ "$ver" -ge 21 ] 2>/dev/null; then
    ok "Java $ver (>= 21)"
  else
    fail "Java $ver found, but 21+ required"
    CHECKS_PASSED=false
  fi
}

check_node_version() {
  if ! command -v node &>/dev/null; then
    fail "node not found. Install Node.js 18+"
    CHECKS_PASSED=false
    return
  fi
  local ver
  ver=$(node --version | grep -oE '[0-9]+' | head -1)
  if [ "$ver" -ge 18 ] 2>/dev/null; then
    ok "Node.js v$ver (>= 18)"
  else
    fail "Node.js v$ver found, but 18+ required"
    CHECKS_PASSED=false
  fi
}

check_port() {
  local port="$1" service="$2"
  if lsof -i ":$port" -sTCP:LISTEN &>/dev/null 2>&1; then
    local pid
    pid=$(lsof -ti ":$port" -sTCP:LISTEN 2>/dev/null | head -1)
    warn "Port $port ($service) in use by PID $pid"
    WARN_COUNT=$((WARN_COUNT + 1))
  else
    ok "Port $port ($service) available"
  fi
}

check_docker_connection() {
  if ! command -v docker &>/dev/null; then
    return
  fi
  if docker info &>/dev/null 2>&1; then
    ok "Docker daemon running"
    # Check if compose is available
    if docker compose version &>/dev/null 2>&1; then
      ok "Docker Compose available"
    else
      fail "docker compose not available"
      CHECKS_PASSED=false
    fi
  else
    fail "Docker daemon not running"
    CHECKS_PASSED=false
  fi
}

check_env() {
  if [ -f "$SCRIPT_DIR/.env" ]; then
    ok ".env file exists"
    # shellcheck source=/dev/null
    source "$SCRIPT_DIR/.env" 2>/dev/null || true
    if [ -z "${TOKEN_ENC_KEY:-}" ]; then
      fail "TOKEN_ENC_KEY is empty in .env"
      echo "    Fix: openssl rand -base64 32"
      CHECKS_PASSED=false
    else
      ok "TOKEN_ENC_KEY configured"
    fi
  else
    fail ".env file missing (copy from .env.example)"
    CHECKS_PASSED=false
  fi
}

echo ""
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║       Code Intelligence — Pre-flight Health Check           ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo ""

info "Environment:"
check_env

info "Tools:"
check_command docker "https://docs.docker.com/get-docker/"
check_docker_connection
check_java_version
check_node_version

info "Ports:"
# Source .env if present for port overrides
[ -f "$SCRIPT_DIR/.env" ] && source "$SCRIPT_DIR/.env" 2>/dev/null || true
check_port "${SERVER_PORT:-8080}" "backend"
check_port 5432 "PostgreSQL"
check_port 6379 "Redis"
check_port 5173 "frontend"

echo ""
if [ "$CHECKS_PASSED" = false ]; then
  fail "Some checks failed. Fix the issues above before running ./start-local"
  exit 1
fi

if [ "$WARN_COUNT" -gt 0 ]; then
  warn "All required checks passed, but $WARN_COUNT warning(s). Review above."
  exit 0
fi

ok "All checks passed! Ready to run ./start-local"
