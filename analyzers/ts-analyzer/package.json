{
  "name": "ts-analyzer",
  "private": true,
  "version": "0.0.1",
  "description": "Stateless TypeScript/JavaScript analysis sidecar (기획서 §4.2, §10.4)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "typescript": "~7.0.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "@nestjs/platform-express": {
      "multer": "2.4.0"
    }
  }
}
