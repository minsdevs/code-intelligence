        "status": {
          "enum": [
            "AUTHOR_PROVISIONAL",
            "INDEPENDENT_REVIEWED",
            "ADJUDICATED"
          ]
        },
        "goldSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "negativesSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "adjudicator": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "reviewerId",
            "kind",
            "decision",
            "goldSha256",
            "negativesSha256"
          ],
          "properties": {
            "reviewerId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "kind": {
              "enum": [
                "HUMAN",
                "AGENT"
              ]
            },
            "decision": {
              "const": "APPROVE"
            },
            "goldSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "negativesSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
