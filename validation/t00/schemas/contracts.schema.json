        "required": {
          "const": true
        },
        "publicSupported": {
          "const": false
        },
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/versionRequirement"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "patternAllocationStatus": {
          "const": "PENDING_INDEPENDENT_REVIEW"
        },
        "sampleRequirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "positive",
            "negative",
            "independentProjects",
            "scenarios",
            "parserFiles",
            "holdoutPositive",
            "holdoutNegative"
          ],
          "properties": {
            "positive": {
              "const": 200
            },
            "negative": {
              "const": 100
            },
            "independentProjects": {
              "const": 3
            },
            "scenarios": {
              "const": 10
            },
            "parserFiles": {
              "enum": [
                0,
                50
              ]
            },
            "holdoutPositive": {
              "const": 50
            },
            "holdoutNegative": {
              "const": 25
            }
          }
        },
        "strata": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stratumId",
              "minimumPositive",
              "minimumNegative",
              "versions"
            ],
            "properties": {
              "stratumId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
              },
              "minimumPositive": {
                "const": 50
              },
              "minimumNegative": {
                "const": 25
              },
              "versions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/versionRequirement"
                },
                "minItems": 1,
                "maxItems": 32
              }
            }
          },
          "minItems": 0,
          "maxItems": 4
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "manifestId",
        "publicSupportPolicy",
        "thresholds",
        "policyReferences",
        "toolInventory",
        "cells"
      ],
      "properties": {
        "contractVersion": {
          "const": "1.0.0"
        },
        "manifestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "publicSupportPolicy": {
          "const": "NO_PROMOTION_IN_T00A"
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parseSuccess",
            "invalidDiagnostics",
            "symbolPrecision",
            "symbolRecall",
            "resolvedPrecision",
            "resolvedRecall",
            "wilsonLower",
            "candidatePrecision",
            "candidateRecall",
            "candidateExactSet",
            "falseResolved"
          ],
          "properties": {
            "parseSuccess": {
              "const": 0.99
            },
            "invalidDiagnostics": {
              "const": 1
            },
            "symbolPrecision": {
              "const": 0.99
            },
            "symbolRecall": {
              "const": 0.95
            },
            "resolvedPrecision": {
              "const": 0.99
            },
            "resolvedRecall": {
              "const": 0.9
            },
            "wilsonLower": {
              "const": 0.95
            },
            "candidatePrecision": {
              "const": 0.9
            },
            "candidateRecall": {
              "const": 0.9
            },
            "candidateExactSet": {
              "const": 0.85
            },
            "falseResolved": {
              "const": 0
            }
          }
        },
        "policyReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "document",
              "sha256"
            ],
            "properties": {
              "document": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "minItems": 2,
          "maxItems": 8
        },
        "toolInventory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "producer",
              "declaredVersion",
              "lockedVersion",
              "observedVersion",
              "artifactSha256",
              "packagingStatus"
            ],
            "properties": {
              "producer": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
              },
              "declaredVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "lockedVersion": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 64
              },
              "observedVersion": {
                "type": "null"
              },
              "artifactSha256": {
                "type": "null"
              },
              "packagingStatus": {
                "const": "NOT_VERIFIED"
              }
            }
          },
          "minItems": 0,
          "maxItems": 32
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          },
          "minItems": 18,
          "maxItems": 18
        }
      }
    },
    "buildComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "kind",
        "files",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "kind": {
          "enum": [
            "FILE",
            "DIRECTORY_TREE"
          ]
        },
        "files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "attestationId",
        "kind",
        "productBuildSha256",
        "build",
        "observationsSha256",
        "corpusSha256",
        "capabilityManifestSha256",
        "runs",
        "execution"
      ],
      "properties": {
        "contractVersion": {
          "const": "1.0.0"
        },
        "attestationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "kind": {
          "enum": [
            "BACKEND_PIPELINE_HARNESS",
            "PACKAGED_APP_API"
          ]
        },
        "productBuildSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "revision",
            "dirtyProductPaths",
            "components"
          ],
          "properties": {
            "path": {
              "enum": [
                "BACKEND_PIPELINE_HARNESS",
                "PACKAGED_APP_API"
              ]
            },
            "revision": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{40}$"
            },
            "dirtyProductPaths": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 100000
            },
            "javaVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "appVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "buildSequence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "components": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/buildComponent"
              },
              "minItems": 1,
              "maxItems": 32
            }
          }
        },
        "observationsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "corpusSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "capabilityManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fixtureId",
              "sourceDigest",
              "consumedSources",
              "executionState"
            ],
            "properties": {
              "fixtureId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
              },
              "sourceDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "consumedSources": {
                "type": "array",
                "minItems": 1,
                "maxItems": 512,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256",
                    "bytes"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                }
              },
              "executionState": {
                "enum": [
                  "COMPLETED",
                  "FAILED"
                ]
              }
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "nonce",
            "startedAt",
            "finishedAt",
            "driverSha256",
            "converterSha256",
            "adapterVersion"
          ],
          "properties": {
            "path": {
              "enum": [
                "BACKEND_PIPELINE_HARNESS",
                "PACKAGED_APP_API"
              ]
            },
            "nonce": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            },
            "startedAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "finishedAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "driverSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "converterSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "harnessSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "adapterVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "revision": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{40}$"
            },
            "electronVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "packagedLaunch": {
              "type": "boolean"
            },
            "validationIdentity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "productRunnerSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  }
}
