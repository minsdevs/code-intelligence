        "observationId",
        "cellId",
        "kind",
        "relationKind",
        "source",
        "resolution",
        "targets",
        "valid",
        "diagnostics",
        "reasonCode"
      ],
      "properties": {
        "observationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "cellId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
