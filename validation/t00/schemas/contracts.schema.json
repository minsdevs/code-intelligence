        "kind": {
          "enum": [
            "PARSER",
            "FACT",
            "CANDIDATES"
          ]
        },
        "relationKind": {
          "enum": [
            "PARSE",
            "SYMBOL",
            "CALLS",
            "FRAMEWORK",
            "HTTP_CONTRACT",
            "DATA_CONTRACT"
          ]
        },
        "source": {
          "$ref": "#/$defs/span"
        },
        "resolution": {
          "enum": [
            "STATIC_RESOLVED",
            "INFERRED",
            "UNRESOLVED",
            "UNSUPPORTED",
            "NOT_APPLICABLE"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 0,
          "maxItems": 20
        },
        "valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "reasonCode": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
