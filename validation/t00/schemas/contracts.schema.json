          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtureId",
        "sourceDigest",
        "executionState",
        "reasonCode",
        "versions",
        "facts",
        "outcomes"
      ],
      "properties": {
        "fixtureId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
